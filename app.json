{
  "expo": {
    "name": "Museo AR",
    "slug": "museo-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "museoar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muvdi.museoar"
    },
    "android": {
      "package": "com.muvdi.museoar",
      "adaptiveIcon": {
        "backgroundColor": "#795900",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBFF",
          "dark": {
            "backgroundColor": "#1E1B16"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "El museo AR usa la cámara trasera para mostrar las obras sobre el mundo real."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de tu galería para colgarlas en el museo AR.",
          "cameraPermission": "Permite tomar fotos para colgarlas en el museo AR."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "El museo AR usa los sensores de movimiento para ubicar las obras a tu alrededor."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
